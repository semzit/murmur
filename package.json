{
  "name": "murmur",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-native distributed inference network",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch examples/react-demo/server.ts",
    "dev:web": "pnpm --filter react-demo dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "turbo": "^2.10.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.30.0"
  },
  "packageManager": "pnpm@9.15.9"
}
