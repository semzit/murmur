{
  "name": "@murmur/runtime",
  "version": "0.1.0",
  "description": "Model execution layer for Murmur: pluggable inference runtimes (ONNX Runtime Web, mock)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@murmur/core": "workspace:*",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jpeg-js": "^0.4.4",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  }
}
